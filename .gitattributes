# Détection automatique des fichiers texte
# et stockage systématique en LF dans Git
* text=auto eol=lf

# Scripts Windows qui doivent rester en CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Fichiers binaires : aucune conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary