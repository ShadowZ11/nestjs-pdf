{
  "name": "@shad0wz7/nestjs-pdf",
  "version": "2.3.2",
  "description": "A NestJS library for generating PDFs with Puppeteer and Handlebars.",
  "author": "Emmanuel Boisset",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "prepare": "husky"
  },
  "keywords": [
    "nestjs",
    "pdf",
    "puppeteer",
    "handlebars",
    "hbs",
    "nunjucks",
    "ejs",
    "mjml",
    "pug",
    "eta",
    "mustache",
    "pdf-lib",
    "pdfjs-dist"
  ],
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "rxjs": "^7.8.0"
  },
  "dependencies": {
    "@puppeteer/browsers": "^3.0.6",
    "deepmerge-ts": "^7.1.5",
    "p-limit": "^7.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "puppeteer": "^25.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.23",
    "@nestjs/config": "^4.0.4",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.27",
    "@swc/core": "^1.15.43",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mjml": "^5.0.0",
    "@types/mjml-core": "^5.0.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.1.0",
    "@types/nunjucks": "^3.2.6",
    "@types/pug": "^2.0.10",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "prettier": "^3.9.4",
    "reflect-metadata": "^0.2.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "optionalDependencies": {
    "@gboutte/nestjs-hbs": "^0.2.0",
    "@napi-rs/canvas": "^1.0.2",
    "ejs": "^6.0.1",
    "eta": "^4.6.0",
    "mjml": "^5.4.0",
    "mustache": "^4.2.0",
    "nunjucks": "^3.2.4",
    "pug": "^3.0.4"
  },
  "repository": {
    "url": "git+https://github.com/ShadowZ11/nestjs-pdf.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "jest": {
    "moduleNameMapper": {
      "@/(.*)$": "<rootDir>/src/$1",
      "^pdfjs-dist/legacy/build/pdf\\.mjs$": "<rootDir>/test/__mocks__/pdfjs-dist.ts",
      "^jwks-rsa$": "<rootDir>/test/__mocks__/jwks-rsa.ts"
    },
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/\\.pnpm/(?!(puppeteer[@+]|puppeteer-core[@+]|@puppeteer\\+))"
    ],
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src/"
    ]
  }
}
