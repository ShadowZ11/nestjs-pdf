{
  "name": "@shad0wz7/nestjs-pdf",
  "version": "2.5.2",
  "description": "A NestJS library for generating PDFs with Puppeteer and multiple engines.",
  "keywords": [
    "nestjs",
    "pdf",
    "puppeteer",
    "handlebars",
    "hbs",
    "nunjucks",
    "ejs",
    "mjml",
    "pug",
    "eta",
    "mustache",
    "pdf-lib",
    "pdfjs-dist"
  ],
  "repository": {
    "url": "git+https://github.com/ShadowZ11/nestjs-pdf.git"
  },
  "license": "MIT",
  "author": "Emmanuel Boisset",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.cts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "build:dev": "tsdown --watch ./src",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "knip": "knip",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:all": "pnpm lint && pnpm sort:check",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "pre-commit": "lint-staged",
    "prepare": "husky",
    "prepublishOnly": "pnpm lint && pnpm test && pnpm build",
    "sort": "sort-package-json",
    "sort:check": "sort-package-json --check",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:watch": "vitest"
  },
  "lint-staged": {
    "*.{ts,tsx,md,graphql,json,html,yaml,css}": [
      "eslint \"{src,test}/**/*.ts\" --fix",
      "pnpm format"
    ]
  },
  "dependencies": {
    "@puppeteer/browsers": "^3.2.1",
    "deepmerge-ts": "^8.0.2",
    "p-limit": "^7.3.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "puppeteer": "^25.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.1",
    "@types/ejs": "^3.1.5",
    "@types/mjml": "^5.0.0",
    "@types/mjml-core": "^5.1.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.4.0",
    "@types/nunjucks": "^3.2.6",
    "@types/pug": "^2.0.10",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "reflect-metadata": "^0.2.2",
    "sort-package-json": "^4.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "rxjs": "^7.8.0"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "ejs": "^6.0.1",
    "eta": "^4.6.0",
    "handlebars": "^4.7.9",
    "mjml": "^5.4.0",
    "mjml-core": "^5.4.0",
    "mustache": "^4.2.0",
    "nunjucks": "^3.2.4",
    "pug": "^3.0.4"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "inlinedDependencies": {
    "@nestjs/config": "4.0.4",
    "@types/mjml-core": "5.1.0",
    "dotenv": "17.4.1",
    "dotenv-expand": "12.0.3",
    "lodash": "4.18.1"
  }
}
